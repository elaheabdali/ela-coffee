# Copy to apps/web/.env.local for local development. Never commit real secrets.
# See docs/fa/phase-06-backend.md for the Neon setup steps.

# Postgres connection string (Neon free tier). Leave unset to run with
# the seed-JSON/in-memory fallback (dev/demo only — data resets on
# restart and is never production behaviour).
# Example shape (replace with your own Neon project string):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DATABASE_URL=""

# Payment provider: "mock" (default, no network, no real money) or
# "zarinpal" (sandbox — needs ZARINPAL_MERCHANT_ID below).
PAYMENT_PROVIDER="mock"

# Zarinpal sandbox merchant ID. Only used when PAYMENT_PROVIDER=zarinpal.
# Get one from the Zarinpal sandbox panel; leave empty for mock mode.
ZARINPAL_MERCHANT_ID=""

# Public variables (add as needed, NEXT_PUBLIC_ prefix):
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
