# Copy to apps/web/.env.local for local development. Never commit real secrets.
# See docs/fa/phase-06-backend.md for the Neon setup steps.

# Postgres connection string (Neon free tier). Leave unset to run with
# the seed-JSON/in-memory fallback (dev/demo only — data resets on
# restart and is never production behaviour).
# Example shape (replace with your own Neon project string):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DATABASE_URL=""

# Payment provider: "mock" (default in code when unset — no network,
# no real money, checkout completes immediately) or "zarinpal" (the
# REAL Zarinpal gateway). The checkout is configured for the real
# sandbox gateway below; see docs/zarinpal-setup.md.
PAYMENT_PROVIDER="zarinpal"

# Sandbox switch for the Zarinpal provider: "true" (default) = the
# real sandbox at sandbox.zarinpal.com, no real money ever moves;
# "false" = production at payment.zarinpal.com. Switching to live is
# config-only: set this to "false" and replace ZARINPAL_MERCHANT_ID
# with the real merchant ID from the Zarinpal panel. No code change.
ZARINPAL_SANDBOX="true"

# Zarinpal merchant ID. Only used when PAYMENT_PROVIDER=zarinpal.
# Server-side only — never NEXT_PUBLIC, never a real credential.
# TEST / PLACEHOLDER UUID for the sandbox (generated for this repo):
# the sandbox accepts ANY UUID as merchant_id and charges no real
# money, so no account is needed to test. Replace with the real
# 36-character merchant ID from the Zarinpal panel for production.
ZARINPAL_MERCHANT_ID="e559409c-3172-4d73-aa25-86b761191865"

# Zarinpal API host override. Only needed to point at a different host
# than the ZARINPAL_SANDBOX flag selects; leave unset in normal use.
# ZARINPAL_BASE_URL="https://sandbox.zarinpal.com"

# Public variables (add as needed, NEXT_PUBLIC_ prefix):
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Canonical / hreflang / OG / sitemap base URL (Phase 8).
# This is the real Vercel production domain (deployed in Phase 11).
# The same value is set as NEXT_PUBLIC_SITE_URL in the Vercel project
# env vars, which overrides this default in production — keep the two
# in sync if the domain ever changes. Do not put a localhost URL here —
# it would become the canonical.
NEXT_PUBLIC_SITE_URL="https://ela-coffee-yi88.vercel.app"
